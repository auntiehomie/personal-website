---
import Base from "@/layouts/Base.astro";

const projects = [
  {
    name: "Homiehouse",
    url: "https://github.com/auntiehomie/homiehouse",
    description:
      "Farcaster client with AI-powered learning hub, feed curation, and progressive difficulty levels. Next.js 14 + Vercel + Neon DB.",
    status: "Active",
    tags: ["Next.js", "Farcaster", "AI", "Web3"],
  },
  {
    name: "Prospect Project Homie",
    url: "https://github.com/auntiehomie/prospectprojecthomie",
    description:
      "Branch-leader prospecting toolkit: public-source discovery, qualification gates, evidence quality controls, and compliant email outreach.",
    status: "Active",
    tags: ["Next.js", "TypeScript", "Banking", "CSV"],
  },
  {
    name: "BankBud",
    url: "https://github.com/auntiehomie/bankbud",
    description:
      "AI personal finance app with bank rate scraping, MongoDB-backed rate comparison, chat analysis, and location-based recommendations.",
    status: "Active",
    tags: ["TypeScript", "MongoDB", "AI", "Finance"],
  },
  {
    name: "Liquidation Bot",
    url: "https://github.com/auntiehomie/liquidation-bot",
    description:
      "Arbitrum DeFi liquidation bot with Next.js monitoring dashboard. Aave v3 integration, P&L tracking, wallet top-up alerts.",
    status: "Active",
    tags: ["TypeScript", "DeFi", "Aave", "Arbitrum"],
  },
  {
    name: "Solana Arb Bot",
    url: "https://github.com/auntiehomie/solana-arb-bot",
    description:
      "Solana arbitrage research project. Jupiter API + Helius + Jito. Rust migration planned for sub-ms execution.",
    status: "Research",
    tags: ["Solana", "DeFi", "Rust", "Arbitrage"],
  },
  {
    name: "Meteora LP Bot",
    url: "https://github.com/auntiehomie/meteora-lp-bot",
    description:
      "Solana LP auto-rebalancer for Meteora DLMM pools. SDK-based position management.",
    status: "Paused",
    tags: ["Solana", "DeFi", "TypeScript"],
  },
  {
    name: "Howdy Morning",
    url: "https://github.com/auntiehomie/howdy-morning",
    description:
      "Morning routine + health app with Oura API integration, LLM scheduling, and habit tracking.",
    status: "Active",
    tags: ["Next.js", "Supabase", "Health", "AI"],
  },
  {
    name: "adaniels.xyz",
    url: "https://github.com/auntiehomie/personal-website",
    description: "This site. Built with Astro and TailwindCSS.",
    status: "Active",
    tags: ["Astro", "TailwindCSS", "Web"],
  },
];
---

<Base
  title="Projects"
  meta_title="Projects — adaniels.xyz"
  description="Things I'm building."
>
  <section class="section">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <h1 class="mb-4">Projects</h1>
          <p class="mb-12 text-lg">
            Things I build, experiment with, and occasionally finish.
          </p>
          <div class="row">
            {
              projects.map((project) => (
                <div class="md:col-6 mb-8">
                  <div class="border border-border rounded-lg p-6 h-full flex flex-col">
                    <div class="flex items-start justify-between mb-3">
                      <h3 class="h5 mb-0">
                        <a
                          href={project.url}
                          target="_blank"
                          rel="noopener"
                          class="hover:text-primary"
                        >
                          {project.name}
                        </a>
                      </h3>
                      <span
                        class={`text-xs px-2 py-1 rounded-full ml-3 flex-shrink-0 ${
                          project.status === "Active"
                            ? "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300"
                            : "bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300"
                        }`}
                      >
                        {project.status}
                      </span>
                    </div>
                    <p class="text-sm mb-4 flex-grow">{project.description}</p>
                    <div class="flex flex-wrap gap-2">
                      {project.tags.map((tag) => (
                        <span class="text-xs px-2 py-1 bg-theme-light dark:bg-darkmode-theme-light rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
